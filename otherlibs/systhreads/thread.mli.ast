  signature_item (otherlibs/systhreads/thread.mli[135,6023+0]..[141,6449+67])
    Psig_attribute "ocaml.text"
    [
      structure_item (otherlibs/systhreads/thread.mli[135,6023+0]..[141,6449+67])
        Pstr_eval
        expression (otherlibs/systhreads/thread.mli[135,6023+0]..[141,6449+67])
          Pexp_constant PConst_string(" Signal handling follows the POSIX thread model: signals generated\n  by a thread are delivered to that thread; signals generated externally\n  are delivered to one of the threads that does not block it.\n  Each thread possesses a set of blocked signals, which can be modified\n  using {!Thread.sigmask}.  This set is inherited at thread creation time.\n  Per-thread signal masks are supported only by the system thread library\n  under Unix, but not under Win32, nor by the VM thread library. ",(otherlibs/systhreads/thread.mli[135,6023+0]..[141,6449+67]),None)
    ]
  signature_item (otherlibs/systhreads/thread.mli[143,6518+0]..[143,6518+62])
    Psig_value
    value_description "sigmask" (otherlibs/systhreads/thread.mli[143,6518+4]..[143,6518+11]) (otherlibs/systhreads/thread.mli[143,6518+0]..[143,6518+62])
      attribute "ocaml.doc"
        [
          structure_item (otherlibs/systhreads/thread.mli[144,6581+0]..[152,6946+77])
            Pstr_eval
            expression (otherlibs/systhreads/thread.mli[144,6581+0]..[152,6946+77])
              Pexp_constant PConst_string(" [sigmask cmd sigs] changes the set of blocked signals for the\n   calling thread.\n   If [cmd] is [SIG_SETMASK], blocked signals are set to those in\n   the list [sigs].\n   If [cmd] is [SIG_BLOCK], the signals in [sigs] are added to\n   the set of blocked signals.\n   If [cmd] is [SIG_UNBLOCK], the signals in [sigs] are removed\n   from the set of blocked signals.\n   [sigmask] returns the set of previously blocked signals for the thread. ",(otherlibs/systhreads/thread.mli[144,6581+0]..[152,6946+77]),None)
        ]
      core_type (otherlibs/systhreads/thread.mli[143,6518+14]..[143,6518+62])
