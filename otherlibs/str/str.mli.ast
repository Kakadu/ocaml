            expression (otherlibs/str/str.mli[252,11220+0]..[257,11500+34])
              Pexp_constant PConst_string(" Same as {!Str.split} but occurrences of the\n   delimiter at the beginning and at the end of the string are\n   recognized and returned as empty strings in the result.\n   For instance, [split_delim (regexp \" \") \" abc \"]\n   returns [[\"\"; \"abc\"; \"\"]], while [split] with the same\n   arguments returns [[\"abc\"]]. ",(otherlibs/str/str.mli[252,11220+0]..[257,11500+34]),None)
