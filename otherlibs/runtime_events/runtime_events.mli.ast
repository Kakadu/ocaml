              Pexp_constant PConst_string(" [pause ()] will pause the collection of events in the runtime.\n   Traces are collected if the program has called [Runtime_events.start ()] or\n   the OCAML_RUNTIME_EVENTS_START environment variable has been set.\n",(otherlibs/runtime_events/runtime_events.mli[175,6754+0]..[178,6969+2]),None)
