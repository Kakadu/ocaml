  signature_item (otherlibs/runtime_events/runtime_events.mli[186,7220+0]..[186,7220+51])
    Psig_value
    value_description "create_cursor" (otherlibs/runtime_events/runtime_events.mli[186,7220+4]..[186,7220+17]) (otherlibs/runtime_events/runtime_events.mli[186,7220+0]..[186,7220+51])
      attribute "ocaml.doc"
        [
          structure_item (otherlibs/runtime_events/runtime_events.mli[187,7272+0]..[195,7864+34])
            Pstr_eval
            expression (otherlibs/runtime_events/runtime_events.mli[187,7272+0]..[195,7864+34])
              Pexp_constant PConst_string(" [create_cursor path_pid] creates a cursor to read from an runtime_events.\n   Cursors can be created for runtime_events in and out of process. A\n   runtime_events ring-buffer may have multiple cursors reading from it at any\n   point in time and a program may have multiple cursors open concurrently\n  (for example if multiple consumers want different sets of events). If\n   [path_pid] is None then a cursor is created for the current process.\n   Otherwise the pair contains a string [path] to the directory that contains\n   the [pid].events file and int [pid] for the runtime_events of an\n   external process to monitor. ",(otherlibs/runtime_events/runtime_events.mli[187,7272+0]..[195,7864+34]),None)
        ]
      core_type (otherlibs/runtime_events/runtime_events.mli[186,7220+20]..[186,7220+51])
