    Pstr_extension "expect"
    [
      structure_item (testsuite/tests/typing-poly/poly.ml[1165,29341+10]..[1186,30326+2])
        Pstr_eval
        expression (testsuite/tests/typing-poly/poly.ml[1165,29341+10]..[1186,30326+2])
          Pexp_constant PConst_string ("\nLine 3, characters 2-64:\n3 | = struct let f (x : <m : 'a. 'a * ('a * 'foo)> as 'foo) = () end;;\n      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nError: Signature mismatch:\n       Modules do not match:\n         sig val f : (< m : 'a. 'a * ('a * 'b) > as 'b) -> unit end\n       is not included in\n         sig\n           val f : < m : 'b. 'b * ('b * < m : 'c. 'c * 'a > as 'a) > -> unit\n         end\n       Values do not match:\n         val f : (< m : 'a. 'a * ('a * 'b) > as 'b) -> unit\n       is not included in\n         val f : < m : 'b. 'b * ('b * < m : 'c. 'c * 'a > as 'a) > -> unit\n       The type (< m : 'a. 'a * ('a * 'd) > as 'd) -> unit\n       is not compatible with the type\n         < m : 'b. 'b * ('b * < m : 'c. 'c * 'e > as 'e) > -> unit\n       The method m has type 'a. 'a * ('a * < m : 'a. 'f >) as 'f,\n       but the expected method type was 'c. 'c * ('b * < m : 'c. 'g >) as 'g\n       The universal variable 'b would escape its scope\n",(testsuite/tests/typing-poly/poly.ml[1165,29341+12]..[1186,30326+0]),Some "")
    ]
