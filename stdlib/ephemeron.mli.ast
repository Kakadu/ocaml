  signature_item (stdlib/ephemeron.mli[74,3652+0]..[78,3852+2])
    Psig_attribute "ocaml.text"
    [
      structure_item (stdlib/ephemeron.mli[74,3652+0]..[78,3852+2])
        Pstr_eval
        expression (stdlib/ephemeron.mli[74,3652+0]..[78,3852+2])
          Pexp_constant PConst_string("\n    Unsynchronized accesses to a weak hash table may lead to an invalid\n    weak hash table state. Thus, concurrent accesses to a buffer must be\n    synchronized (for instance with a {!Mutex.t}).\n",(stdlib/ephemeron.mli[74,3652+0]..[78,3852+2]),None)
    ]
