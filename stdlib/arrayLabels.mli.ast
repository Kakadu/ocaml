            expression (stdlib/arrayLabels.mli[297,11735+0]..[304,12117+2])
              Pexp_constant PConst_string(" Same as {!sort}, but the sorting algorithm is stable (i.e.\n   elements that compare equal are kept in their original order) and\n   not guaranteed to run in constant heap space.\n\n   The current implementation uses Merge Sort. It uses a temporary array of\n   length [n/2], where [n] is the length of the array.  It is usually faster\n   than the current implementation of {!sort}.\n",(stdlib/arrayLabels.mli[297,11735+0]..[304,12117+2]),None)
        ]
