    value_description "print_backtrace" (stdlib/printexc.mli[50,2454+4]..[50,2454+19]) (stdlib/printexc.mli[50,2454+0]..[50,2454+40])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/printexc.mli[51,2495+0]..[63,3083+2])
            Pstr_eval
            expression (stdlib/printexc.mli[51,2495+0]..[63,3083+2])
              Pexp_constant PConst_string(" [Printexc.print_backtrace oc] prints an exception backtrace\n    on the output channel [oc].  The backtrace lists the program\n    locations where the most-recently raised exception was raised\n    and where it was propagated through function calls.\n\n    If the call is not inside an exception handler, the returned\n    backtrace is unspecified. If the call is after some\n    exception-catching code (before in the handler, or in a when-guard\n    during the matching of the exception handler), the backtrace may\n    correspond to a later exception than the handled one.\n\n    @since 3.11\n",(stdlib/printexc.mli[51,2495+0]..[63,3083+2]),None)
        ]
      core_type (stdlib/printexc.mli[50,2454+21]..[50,2454+40])
