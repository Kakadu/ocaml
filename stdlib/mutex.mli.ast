    value_description "protect" (stdlib/mutex.mli[62,2633+4]..[62,2633+11]) (stdlib/mutex.mli[62,2633+0]..[62,2633+37])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/mutex.mli[63,2671+0]..[71,3044+17])
            Pstr_eval
            expression (stdlib/mutex.mli[63,2671+0]..[71,3044+17])
              Pexp_constant PConst_string(" [protect mutex f] runs [f()] in a critical section where [mutex]\n    is locked (using {!lock}); it then takes care of releasing [mutex],\n    whether [f()] returned a value or raised an exception.\n\n    The unlocking operation is guaranteed to always takes place,\n    even in the event an asynchronous exception (e.g. {!Sys.Break}) is raised\n    in some signal handler.\n\n    @since 5.1 ",(stdlib/mutex.mli[63,2671+0]..[71,3044+17]),None)
        ]
