          structure_item (stdlib/mutex.mli[54,2236+0]..[60,2575+56])
            Pstr_eval
            expression (stdlib/mutex.mli[54,2236+0]..[60,2575+56])
              Pexp_constant PConst_string(" Unlock the given mutex. Other threads suspended trying to lock\n   the mutex will restart.  The mutex must have been previously locked\n   by the thread that calls {!Mutex.unlock}.\n   @raise Sys_error if the mutex is unlocked or was locked by another thread.\n\n   @before 4.12 {!Sys_error} was not raised when unlocking an unlocked mutex\n   or when unlocking a mutex from a different thread. ",(stdlib/mutex.mli[54,2236+0]..[60,2575+56]),None)
        ]
