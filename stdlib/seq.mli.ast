    value_description "unzip" (stdlib/seq.mli[672,24258+4]..[672,24258+9]) (stdlib/seq.mli[672,24258+0]..[672,24258+38])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/seq.mli[673,24297+0]..[684,24694+18])
            Pstr_eval
            expression (stdlib/seq.mli[673,24297+0]..[684,24694+18])
              Pexp_constant PConst_string(" [unzip] transforms a sequence of pairs into a pair of sequences.\n\n    [unzip xs] is equivalent to [(map fst xs, map snd xs)].\n\n    Querying either of the sequences returned by [unzip xs]\n    causes [xs] to be queried.\n    Therefore, querying both of them\n    causes [xs] to be queried twice.\n    Thus, [xs] must be persistent and cheap.\n    If that is not the case, use [unzip (memoize xs)].\n\n    @since 4.14 ",(stdlib/seq.mli[673,24297+0]..[684,24694+18]),None)
        ]
