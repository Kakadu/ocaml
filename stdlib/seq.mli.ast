  signature_item (stdlib/seq.mli[652,23582+0]..[652,23582+58])
    Psig_value
    value_description "map_product" (stdlib/seq.mli[652,23582+4]..[652,23582+15]) (stdlib/seq.mli[652,23582+0]..[652,23582+58])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/seq.mli[653,23641+0]..[668,24186+18])
            Pstr_eval
            expression (stdlib/seq.mli[653,23641+0]..[668,24186+18])
              Pexp_constant PConst_string(" The sequence [map_product f xs ys] is the image through [f]\n    of the Cartesian product of the sequences [xs] and [ys].\n\n    For every element [x] of [xs] and for every element [y] of [ys],\n    the element [f x y] appears once as an element of [map_product f xs ys].\n\n    The order in which these elements appear is unspecified.\n\n    The sequences [xs] and [ys] are not required to be finite.\n\n    The sequences [xs] and [ys] must be persistent.\n\n    [map_product f xs ys] is equivalent to\n    [map (fun (x, y) -> f x y) (product xs ys)].\n\n    @since 4.14 ",(stdlib/seq.mli[653,23641+0]..[668,24186+18]),None)
        ]
      core_type (stdlib/seq.mli[652,23582+18]..[652,23582+58])
