    Psig_value
    value_description "stable_sort" (stdlib/templates/floatarraylabeled.template.mli[190,8183+4]..[190,8183+15]) (stdlib/templates/floatarraylabeled.template.mli[190,8183+0]..[190,8183+58])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/templates/floatarraylabeled.template.mli[191,8242+0]..[197,8573+72])
            Pstr_eval
            expression (stdlib/templates/floatarraylabeled.template.mli[191,8242+0]..[197,8573+72])
              Pexp_constant PConst_string(" Same as {!sort}, but the sorting algorithm is stable (i.e.\n     elements that compare equal are kept in their original order) and\n     not guaranteed to run in constant heap space.\n\n     The current implementation uses Merge Sort. It uses a temporary\n     floatarray of length [n/2], where [n] is the length of the floatarray.\n     It is usually faster than the current implementation of {!sort}. ",(stdlib/templates/floatarraylabeled.template.mli[191,8242+0]..[197,8573+72]),None)
        ]
