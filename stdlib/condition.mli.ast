    value_description "signal" (stdlib/condition.mli[163,7578+4]..[163,7578+10]) (stdlib/condition.mli[163,7578+0]..[163,7578+22])
      attribute "ocaml.doc"
        [
          structure_item (stdlib/condition.mli[164,7601+0]..[169,7816+65])
            Pstr_eval
            expression (stdlib/condition.mli[164,7601+0]..[169,7816+65])
              Pexp_constant PConst_string("[signal c] wakes up one of the threads waiting on the condition\n   variable [c], if there is one. If there is none, this call has\n   no effect.\n\n   It is recommended to call [signal c] inside a critical section,\n   that is, while the mutex [m] associated with [c] is locked. ",(stdlib/condition.mli[164,7601+0]..[169,7816+65]),None)
        ]
      core_type (stdlib/condition.mli[163,7578+13]..[163,7578+22])
