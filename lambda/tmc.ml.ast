            expression (lambda/tmc.ml[176,6937+0]..[180,7211+33])
              Pexp_constant PConst_string(" The type ['a Dps.t] (destination-passing-style) represents a\n    version of ['a] that is parametrized over a [lambda destination].\n    A [lambda Dps.t] is a code fragment in destination-passing-style,\n    a [(lambda * lambda) Dps.t] represents two subterms parametrized\n    over the same destination. ",(lambda/tmc.ml[176,6937+0]..[180,7211+33]),None)
        ]
