          Pexp_constant PConst_string(" Tail-modulo-cons optimization.\n\n  {b Warning:} this module is unstable and part of\n  {{!Compiler_libs}compiler-libs}.\n",(lambda/tmc.mli[18,1236+0]..[22,1358+2]),None)
