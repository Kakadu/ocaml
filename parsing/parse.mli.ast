  signature_item (parsing/parse.mli[35,1780+0]..[35,1780+43])
    Psig_value
    value_description "longident" (parsing/parse.mli[35,1780+4]..[35,1780+13]) (parsing/parse.mli[35,1780+0]..[35,1780+43])
      attribute "ocaml.doc"
        [
          structure_item (parsing/parse.mli[36,1824+0]..[50,2560+2])
            Pstr_eval
            expression (parsing/parse.mli[36,1824+0]..[50,2560+2])
              Pexp_constant PConst_string("\n   The function [longident] is guaranteed to parse all subclasses\n   of {!Longident.t} used in OCaml: values, constructors, simple or extended\n   module paths, and types or module types.\n\n   However, this function accepts inputs which are not accepted by the\n   compiler, because they combine functor applications and infix operators.\n   In valid OCaml syntax, only value-level identifiers may end with infix\n   operators [Foo.( + )].\n   Moreover, in value-level identifiers the module path [Foo] must be simple\n   ([M.N] rather than [F(X)]): functor applications may only appear in\n   type-level identifiers.\n   As a consequence, a path such as [F(X).( + )] is not a valid OCaml\n   identifier; but it is accepted by this function.\n",(parsing/parse.mli[36,1824+0]..[50,2560+2]),None)
        ]
      core_type (parsing/parse.mli[35,1780+15]..[35,1780+43])
        Ptyp_arrow
        Nolabel
        core_type (parsing/parse.mli[35,1780+15]..[35,1780+28])
          Ptyp_constr "Lexing.lexbuf" (parsing/parse.mli[35,1780+15]..[35,1780+28])
          []
        core_type (parsing/parse.mli[35,1780+32]..[35,1780+43])
          Ptyp_constr "Longident.t" (parsing/parse.mli[35,1780+32]..[35,1780+43])
          []
      []
